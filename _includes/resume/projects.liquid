<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="cv-entry">
        {% include cv/entry-date.liquid start_date=content.startDate end_date=content.endDate %}
        <div class="cv-entry-body">
          <h6 class="title font-weight-bold">
            {% if content.url and content.url != '' %}
              <a href="{{ content.url | relative_url }}">{{ content.name }}</a>
            {% else %}
              {{ content.name }}
            {% endif %}
          </h6>
          <h6 style="font-size: 0.95rem; font-style: italic">{{ content.summary }}</h6>
          <ul class="items">
            {% for item in content.highlights %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
