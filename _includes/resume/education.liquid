<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="cv-entry">
        {% include cv/entry-date.liquid start_date=content.startDate end_date=content.endDate location=content.location %}
        <div class="cv-entry-body">
          <h6 class="title font-weight-bold">
            <a href="{{ content.url }}">{{ content.studyType }}</a>
          </h6>
          <h6 style="font-size: 0.95rem">{{ content.institution }}</h6>
          <h6 style="font-size: 0.95rem; font-style: italic">{{ content.area }}</h6>
          {% if content.advisor %}
            <p class="mb-0">Advised by {{ content.advisor | escape }}</p>
          {% endif %}
          <ul class="items">
            {% for item in content.courses %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
