<ul class="row mx-0 mb-0 pl-4">
  {% for interest in data[1] %}
    <li class="col-md-6 pl-0 pr-3">
      {% if interest.icon and interest.icon != '' %}
        <i class="{{ interest.icon | escape }}" aria-hidden="true"></i>
      {% endif %}
      {{ interest.name | escape }}
      {% if interest.keywords.size > 0 %}
        <ul class="mb-0 pl-4">
          {% for keyword in interest.keywords %}
            <li>{{ keyword | escape }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
